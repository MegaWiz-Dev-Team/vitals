{
 "_note": "OSCE station A2 — converted from embla-cases ddx-anaphylaxis-2 v1.0.0 (sha256:57f50cb87ca01014). Presentation follows the deploy-safe form; the hidden block informed only the rubric (demo/rubrics/osce-a2.json). Clinically shaped, not clinically reviewed. Where A drilled the reflex — adrenaline without hesitation — A2 teaches recognition in disguise: anaphylaxis arriving as a gut story (cramps, diarrhoea, a blackout she will not admit to) with the pressure already down. The trap is the antihistamine-first reflex: treating the itch while the shock runs, and the evasive history that hides the collapse unless you ask for it directly.",
 "setting": "ED",
 "tick_seconds": 1.0,
 "vitals0": { "hr": 124, "sbp": 86, "dbp": 54, "spo2": 93, "rr": 24, "temp": 36.9, "gcs": 15 },
 "initial_state": "consult",
 "states": [
  {
   "id": "consult",
   "status": "deteriorating",
   "dynamics": [
    { "var": "sbp",  "rate_per_min": -4,   "floor": 46, "when": { "flag": "adrenaline_given", "is": false } },
    { "var": "spo2", "rate_per_min": -0.6, "floor": 82, "when": { "flag": "adrenaline_given", "is": false } },
    { "var": "hr",   "rate_per_min": 2,    "ceil": 158, "when": { "flag": "adrenaline_given", "is": false } }
   ],
   "bands": [
    { "status": "critical", "when": { "var": "sbp", "op": "lt", "value": 70 } }
   ],
   "transitions": [
    { "to_state": "recovering", "when": { "flag": "adrenaline_given" } },
    { "outcome": "death_arrest",
      "when": { "any": [
       { "var": "sbp",  "op": "lt", "value": 58 },
       { "var": "spo2", "op": "lt", "value": 84 }
      ] } }
   ]
  },
  {
   "id": "recovering",
   "status": "improving",
   "dynamics": [
    { "var": "sbp",  "rate_per_min": 9,   "ceil": 118 },
    { "var": "spo2", "rate_per_min": 1.5, "ceil": 98 },
    { "var": "hr",   "rate_per_min": -6,  "floor": 96 }
   ],
   "bands": [],
   "transitions": []
  }
 ],
 "interventions": [
  {
   "id": "ask_allergy",
   "label": "Ask about known allergies",
   "match": { "any_kw": ["allerg", "แพ้"] },
   "effects": [ { "beat": "— \"Peanuts. Badly, since I was a girl — it is written in my old hospital book.\" She scratches as she says it." } ]
  },
  {
   "id": "ask_exposure",
   "label": "Ask what she ate",
   "match": { "any_kw": ["what did you eat", "food", "eaten", "eat today", "meal", "กิน"] },
   "effects": [ { "beat": "— \"Somtam from my daughter's stall. There could have been ground peanut on top — it all started so fast after.\"" } ]
  },
  {
   "id": "ask_bowels",
   "label": "Ask about the diarrhoea",
   "match": { "any_kw": ["diarrh", "stool", "bowel", "tummy", "belly", "ท้องเสีย"] },
   "effects": [ { "beat": "— \"Three times in an hour, and the cramps twist like a wrung cloth.\" The gut is a shock organ too." } ]
  },
  {
   "id": "ask_faint",
   "label": "Ask if she blacked out",
   "match": { "any_kw": ["faint", "collapse", "pass out", "black out", "conscious", "หมดสติ", "วูบ"] },
   "effects": [ { "beat": "— \"…I sat down hard for a moment. On the floor. Don't tell my daughter.\" A blackout she calls sitting down." } ]
  },
  {
   "id": "exam_skin",
   "label": "Look at the skin",
   "match": { "any_kw": ["skin", "rash", "wheal"] },
   "effects": [ { "beat": "pink wheals broader than a thumbnail, everywhere — and the face swelling: forehead, both cheeks, the nose" } ]
  },
  {
   "id": "exam_chest",
   "label": "Listen to the chest",
   "match": { "any_kw": ["listen", "auscult", "wheeze"] },
   "effects": [ { "beat": "expiratory wheeze both sides, and she is working for it" } ]
  },
  {
   "id": "adrenaline_im",
   "label": "Adrenaline 0.5 mg IM",
   "match": { "any_kw": ["adren", "epinep", "epipen"], "not_kw": [" iv", "push", "intraven", "infus"] },
   "effects": [
    { "flag": "adrenaline_given" },
    { "delta": { "sbp": 14 }, "cap": 118 },
    { "delta": { "spo2": 2 }, "cap": 99 },
    { "beat": "adrenaline 0.5 mg im, outer thigh — the itch was a systemic illness all along" }
   ]
  },
  {
   "id": "adrenaline_iv_push",
   "label": "IV-push adrenaline (HARM)",
   "match": { "all_groups": [["adren", "epinep", "epipen"], [" iv", "push", "intraven", "infus"]] },
   "harm": "iv push adrenaline — arrhythmia on a beating heart",
   "effects": [
    { "delta": { "hr": 30 }, "cap": 175 },
    { "delta": { "sbp": -12 }, "floor": 42 }
   ]
  },
  {
   "id": "oxygen",
   "label": "High-flow oxygen",
   "match": { "any_kw": ["oxygen", "o2", "mask", "cannula"] },
   "effects": [ { "delta": { "spo2": 3 }, "cap": 99 } ],
   "equipment": "o2",
   "equipment_setting": 10
  },
  {
   "id": "saline",
   "label": "IV access + saline, running hard",
   "match": { "any_kw": ["saline", "fluid", "bolus", "iv access", "ringer"] },
   "effects": [
    { "delta": { "sbp": 8 }, "cap": 112 },
    { "beat": "a litre of warmed saline wide open — the shock gets volume, not just adrenaline" }
   ],
   "equipment": "iv",
   "equipment_setting": 999
  },
  {
   "id": "supine",
   "label": "Lay her flat, legs up",
   "match": { "any_kw": ["lay", "flat", "legs up", "supine"] },
   "effects": [ { "delta": { "sbp": 5 }, "cap": 110 } ]
  },
  {
   "id": "glucose",
   "label": "Blood glucose",
   "match": { "any_kw": ["glucose", "sugar level", "dtx", "dextrostix"] },
   "effects": [ { "beat": "glucose 7.2 on a diabetic chart — the sugar is not the story tonight" } ]
  },
  {
   "id": "tryptase",
   "label": "Serum tryptase",
   "match": { "any_kw": ["tryptase"] },
   "effects": [ { "beat": "tryptase 41.6 (ref < 11.4) — the mast cells shouting" } ]
  },
  {
   "id": "ecg",
   "label": "12-lead ECG",
   "match": { "any_kw": ["ecg", "ekg", "12-lead"] },
   "effects": [ { "beat": "sinus tachycardia 124 — no ischaemia behind the collapse" } ]
  },
  {
   "id": "chlorpheniramine",
   "label": "Antihistamine",
   "match": { "any_kw": ["chlorphen", "antihist", "cetiriz", "lorata"] },
   "effects": [ { "beat": "antihistamine for the itch — it will not hold a falling pressure" } ]
  },
  {
   "id": "hydrocortisone",
   "label": "Steroid",
   "match": { "any_kw": ["hydrocort", "steroid", "dexameth"] },
   "effects": [ { "beat": "steroid on board — for the late phase, not for now" } ]
  },
  {
   "id": "dx_anaphylaxis",
   "label": "Name the diagnosis",
   "match": { "any_kw": ["anaphyla"] },
   "effects": [ { "flag": "dx_named" }, { "beat": "anaphylaxis — skin plus gut plus a pressure of 86: two systems and a collapse" } ]
  },
  {
   "id": "dx_gastro",
   "label": "Call it food poisoning",
   "match": { "any_kw": ["food poison", "gastroenteritis", "stomach bug"] },
   "effects": [ { "beat": "food poisoning? — poisoning does not swell a face or drop a pressure in forty minutes. count the systems." } ]
  },
  {
   "id": "observe",
   "label": "Admit for observation",
   "match": { "any_kw": ["admit", "observ", "monitor"] },
   "effects": [ { "flag": "observed" }, { "beat": "admitted under the nurses' eyes — the second wave finds an empty corridor" } ]
  },
  {
   "id": "discharge",
   "label": "Discharge home (HARM)",
   "match": { "any_kw": ["discharge", "go home", "send her home"] },
   "harm": "discharged during the observation window — biphasic reactions return to an empty bed",
   "effects": []
  }
 ],
 "triggers": [
  {
   "id": "antihistamine_first",
   "once": true,
   "when": { "all": [
    { "in_state": "consult" },
    { "done": "chlorpheniramine" },
    { "not": { "done": "adrenaline_im" } },
    { "var": "t_elapsed", "op": "ge", "value": 120 }
   ] },
   "do": [
    { "harm": "antihistamine first while the pressure fell — the itch was never the emergency" },
    { "delta": { "sbp": -6 }, "floor": 46 }
   ]
  },
  {
   "id": "adrenaline_delayed",
   "once": true,
   "when": { "all": [
    { "in_state": "consult" },
    { "var": "t_elapsed", "op": "ge", "value": 300 },
    { "not": { "done": "adrenaline_im" } }
   ] },
   "do": [
    { "harm": "adrenaline delayed — anaphylaxis is treated the moment it is named" },
    { "delta": { "sbp": -10 }, "floor": 46 }
   ]
  },
  {
   "id": "observed_and_home",
   "once": true,
   "when": { "all": [
    { "in_state": "recovering" },
    { "var": "t_in_state", "op": "ge", "value": 150 }
   ] },
   "do": [ { "outcome": "win_discharge" } ]
  }
 ],
 "outcomes": [
  { "id": "win_discharge", "kind": "win",   "label": "Named through the disguise, treated on time — home with an auto-injector" },
  { "id": "death_arrest",  "kind": "death", "label": "The pressure ran out while the itch was being treated" }
 ]
}

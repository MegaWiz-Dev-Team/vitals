{
 "_comment": "SCE block for EP1 severe anaphylaxis. Parity target: engine/src/physiology.rs Scenario::anaphylaxis_ep1 — every hardcoded Cfg param + Iv effect is reproduced here as data. Nests under a Case as the optional top-level `scenario` key. Parameters are illustrative, PENDING CLINICAL REVIEW (Resuscitation Council / WAO).",
 "setting": "ED",
 "tick_seconds": 1.0,
 "vitals0": {
  "hr": 128,
  "sbp": 88,
  "dbp": 54,
  "spo2": 91,
  "rr": 28,
  "temp": 37,
  "gcs": 15
 },
 "variables": {
  "airway_patency": {
   "init": 0.6,
   "min": 0.0,
   "max": 1.0
  }
 },
 "initial_state": "acute",
 "states": [
  {
   "id": "acute",
   "status": "deteriorating",
   "dynamics": [
    {
     "var": "airway_patency",
     "rate_per_min": -0.08,
     "floor": 0.0,
     "when": {
      "all": [
       {
        "flag": "adrenaline_active",
        "is": false
       },
       {
        "flag": "airway_secured",
        "is": false
       }
      ]
     }
    },
    {
     "var": "sbp",
     "rate_per_min": -6.0,
     "floor": 0.0,
     "when": {
      "flag": "adrenaline_active",
      "is": false
     }
    },
    {
     "var": "spo2",
     "rate_per_min": -2.0,
     "floor": 0.0,
     "when": {
      "flag": "adrenaline_active",
      "is": false
     }
    }
   ],
   "bands": [
    {
     "status": "improving",
     "when": {
      "flag": "adrenaline_active"
     }
    },
    {
     "status": "critical",
     "when": {
      "any": [
       {
        "var": "airway_patency",
        "op": "lt",
        "value": 0.3
       },
       {
        "var": "sbp",
        "op": "lt",
        "value": 60
       },
       {
        "var": "spo2",
        "op": "lt",
        "value": 85
       }
      ]
     }
    }
   ],
   "transitions": [
    {
     "to_state": "arrest",
     "when": {
      "any": [
       {
        "var": "airway_patency",
        "op": "lt",
        "value": 0.15
       },
       {
        "var": "sbp",
        "op": "lt",
        "value": 50
       }
      ]
     }
    },
    {
     "to_state": "recovered",
     "when": {
      "all": [
       {
        "var": "airway_patency",
        "op": "gt",
        "value": 0.7
       },
       {
        "var": "sbp",
        "op": "gt",
        "value": 100
       },
       {
        "var": "spo2",
        "op": "gt",
        "value": 94
       }
      ]
     }
    }
   ]
  },
  {
   "id": "recovered",
   "status": "recovered",
   "transitions": []
  },
  {
   "id": "biphasic_controlled",
   "status": "recovered",
   "transitions": [
    {
     "outcome": "win_discharge",
     "when": {
      "var": "t_in_state",
      "op": "ge",
      "value": 180
     }
    }
   ]
  },
  {
   "id": "biphasic_decline",
   "status": "deteriorating",
   "dynamics": [
    {
     "var": "airway_patency",
     "rate_per_min": -0.08,
     "floor": 0.0,
     "when": {
      "flag": "airway_secured",
      "is": false
     }
    },
    {
     "var": "sbp",
     "rate_per_min": -6.0,
     "floor": 0.0
    },
    {
     "var": "spo2",
     "rate_per_min": -2.0,
     "floor": 0.0
    }
   ],
   "bands": [
    {
     "status": "critical",
     "when": {
      "any": [
       {
        "var": "airway_patency",
        "op": "lt",
        "value": 0.3
       },
       {
        "var": "sbp",
        "op": "lt",
        "value": 60
       },
       {
        "var": "spo2",
        "op": "lt",
        "value": 85
       }
      ]
     }
    }
   ],
   "transitions": [
    {
     "outcome": "death_biphasic",
     "when": {
      "any": [
       {
        "var": "airway_patency",
        "op": "lt",
        "value": 0.15
       },
       {
        "var": "sbp",
        "op": "lt",
        "value": 50
       }
      ]
     }
    }
   ]
  },
  {
   "id": "arrest",
   "status": "arrest",
   "_rhythm_note": "PEA, not VF. Anaphylactic arrest is overwhelmingly PEA or asystole — the heart is empty from vasodilation and capillary leak, not electrically chaotic. A monitor drawing VF here would teach the learner to shock, when the treatment is adrenaline, fluid and compressions.",
   "rhythm": "pea",
   "transitions": [
    {
     "outcome": "death_arrest",
     "when": {
      "var": "t_in_state",
      "op": "ge",
      "value": 180
     }
    }
   ]
  }
 ],
 "triggers": [
  {
   "id": "biphasic_onset",
   "once": true,
   "when": {
    "all": [
     {
      "in_state": "recovered"
     },
     {
      "var": "t_in_state",
      "op": "ge",
      "value": 120
     }
    ]
   },
   "do": [
    {
     "beat": "biphasic"
    },
    {
     "branch": [
      {
       "if": {
        "flag": "discharged"
       },
       "then": [
        {
         "to_state": "biphasic_decline"
        }
       ]
      }
     ],
     "else": [
      {
       "to_state": "biphasic_controlled"
      }
     ]
    }
   ]
  },
  {
   "id": "o2_floor",
   "once": false,
   "when": {
    "all": [
     {
      "flag": "o2_on"
     },
     {
      "var": "spo2",
      "op": "lt",
      "value": 88
     }
    ]
   },
   "do": [
    {
     "set": {
      "spo2": 88
     }
    }
   ]
  }
 ],

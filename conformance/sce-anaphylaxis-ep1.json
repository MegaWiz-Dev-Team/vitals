 "debrief": {
  "_comment": "What a clinician expects of this case, and by when. Targets belong here rather than in code: they are clinical judgement, they differ by scenario, and a doctor must be able to change one without a programmer. Everything the debrief reports without a target is a plain fact about the tape — a time, an order, a duration.",
  "expect": [
   {
    "id": "adrenaline_im",
    "label": "IM adrenaline",
    "within_sec": 60,
    "why": "First line, and delay to adrenaline is the strongest predictor of death in anaphylaxis."
   },
   {
    "id": "oxygen",
    "label": "supplemental oxygen",
    "within_sec": 120,
    "why": "Hypoxia is what kills first while the adrenaline is taking hold."
   },
   {
    "id": "supine",
    "label": "lay her flat, legs up",
    "within_sec": 180,
    "why": "Restores preload in distributive shock and costs nothing."
   },
   {
    "id": "fluids",
    "label": "IV fluid",
    "within_sec": 300,
    "why": "The vasodilated circulation needs volume as well as vasoconstriction."
   },
   {
    "id": "admit",
    "label": "admit for observation",
    "why": "A biphasic reaction returns hours later. Sending her home is the trap this case is built around."
   }
  ],
  "avoid": [
   {
    "id": "stand",
    "label": "standing her up",
    "why": "Sitting or standing a patient in anaphylactic shock empties the ventricle and can arrest them outright."
   },
   {
    "id": "discharge",
    "label": "discharging her early",
    "why": "She looks better before the second phase, which is precisely when it comes back."
   }
  ]
 }
}
   "bands": [],
   "transitions": []
  },
  {
   "id": "exsanguinated",
   "status": "arrest",
   "_rhythm_note": "PEA. Clinical judgement, confirmed by the producer 2026-08-29, and going to the clinical reviewer as a confirmation rather than a blocker. Traumatic cardiac arrest from haemorrhage presents in hypovolaemic PEA far more often than in anything else: the heart is empty, not electrically chaotic, which is why the rate is still 144 with no output behind it. Declared PEA and not VF on purpose — the worst reflex at a blast scene is reaching for a defibrillator instead of the tourniquet, the blood and the chest, so a shock here must stay charted as the error it is. Same rate caveat as ep3: asystole is the alternative if the reviewer wants a late exsanguination, and the case would have to drive the rate down first.",
   "rhythm": "pea",
   "dynamics": [],
   "bands": [],
   "transitions": [
    {
     "outcome": "death_arrest",
     "when": {
      "var": "t_in_state",
      "op": "ge",
      "value": 1
     }
    }
   ]
  }
 ],

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The patient factory against the production ward. The same binary as the staging job
       beside it, with its own world directory (its own ledger: a ledger belongs to one ward and
       the binary refuses one written for another) and the shared faces directory (the manifest,
       the face bytes: a face made for one ward is on file for the other). The door token is read
       from the production project's own vitals-door-token secret at run time and is written
       nowhere. Run one factory per ward; the two jobs may run side by side. -->
  <key>Label</key>
  <string>com.vitals.world-factory-prod</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/mimir/Developer/vitals/target/release/vitals-factory</string>
    <string>--once</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>WARD</key>
    <string>https://world.vitals.academy</string>
    <key>QUEUE_DEPTH</key>
    <string>20</string>
    <key>BASES_PER_TICK</key>
    <string>2</string>
    <key>VITALS_REPO</key>
    <string>/Users/mimir/Developer/vitals</string>
    <key>VITALS_WORLD_DIR</key>
    <string>/Users/mimir/.vitals/world-prod</string>
    <key>VITALS_FACES_DIR</key>
    <string>/Users/mimir/.vitals/world</string>
    <key>VITALS_GCP_PROJECT</key>
    <string>vitals-academy</string>
    <key>VITALS_VERTEX_PROJECT</key>
    <string>vitals-academy</string>
    <key>VITALS_JUDGE_MODEL</key>
    <string>gemini-2.5-flash</string>
    <key>EDITS_PER_DAY</key>
    <string>40</string>
    <key>PATH</key>
    <string>/Users/mimir/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>WorkingDirectory</key>
  <string>/Users/mimir/Developer/vitals</string>
  <key>StartInterval</key>
  <integer>600</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/mimir/.vitals/world-prod/factory.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mimir/.vitals/world-prod/factory.err</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
